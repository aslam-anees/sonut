# @code Environment Configuration

# Supabase (Authentication)
# Optional: configure your own project. No credentials are bundled.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/callback

# atcode engine
ATCODE_LLAMA_PORT=2748
ATCODE_GPU_LAYERS=999
ATCODE_CONTEXT_SIZE=256k
ATCODE_MODEL_DIR=~/.atcode/model
# Optional for private model repositories; public downloads need no token.
# ATCODE_MODEL_TOKEN=

# Application
ATCODE_VERBOSE=0
ATCODE_TELEMETRY=0

# Optional: Custom settings
# ATCODE_CONFIG_DIR=~/.atcode
